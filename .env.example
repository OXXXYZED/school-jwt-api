# Copy to .env: cp .env.example .env
# Local development uses the values below as is. For docker compose (VPS) set DOMAIN and
# DJANGO_SECRET_KEY; compose forces DEBUG off and derives hosts/proxy settings from DOMAIN.

# Public domain for docker compose / Caddy, e.g. school.example.com or <VPS-IP>.sslip.io
DOMAIN=

DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0; with DEBUG on an insecure dev key is used if empty.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Trusted reverse proxies in front of the app (compose sets 1 for Caddy)
DJANGO_NUM_PROXIES=0

# JWT (signing key defaults to DJANGO_SECRET_KEY)
# JWT_SIGNING_KEY=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Rate limits for unauthenticated endpoints
THROTTLE_LOGIN_RATE=10/minute
THROTTLE_REGISTER_RATE=5/minute
