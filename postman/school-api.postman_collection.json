                  "  const student = pm.response.json().results.find(s => s.username === pm.collectionVariables.get('studentUsername'));",
                  "  pm.test('student is listed', () => pm.expect(student).to.be.an('object'));",
                  "  pm.collectionVariables.set('studentId', student.id);",
                  "})();"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/students/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "students",
                ""
              ]
            }
          }
        },
