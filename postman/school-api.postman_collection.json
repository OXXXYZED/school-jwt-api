          "name": "Create grade",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(() => {",
                  "  pm.test('status 201', () => pm.response.to.have.status(201));",
                  "  const grade = pm.response.json();",
                  "  pm.collectionVariables.set('gradeId', grade.id);",
                  "  pm.test('teacher is the author', () => pm.expect(grade.teacher_name).to.be.a('string').and.not.empty);",
                  "})();"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/school/grades/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "school",
                "grades",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student\": {{studentId}},\n  \"subject\": \"Postman\",\n  \"value\": 5,\n  \"comment\": \"Создано из Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update grade",
          "event": [
