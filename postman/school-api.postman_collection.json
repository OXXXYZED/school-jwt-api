                  "  const ids = pm.response.json().results.map(g => g.id);",
                  "  pm.test('contains the new grade', () => pm.expect(ids).to.include(Number(pm.collectionVariables.get('gradeId'))));",
                  "})();"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
