              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(() => {",
                  "  pm.test('status 200', () => pm.response.to.have.status(200));",
                  "  pm.test('value updated', () => pm.expect(pm.response.json().value).to.eql(4));",
                  "})();"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
