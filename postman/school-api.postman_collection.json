{
  "info": {
    "name": "School API",
    "description": "Сценарий по ролям для School API (JWT + Base64).\n\n1. Укажите в переменных коллекции `password` (пароль демо-пользователей); `baseUrl` по умолчанию — публичный стенд.\n2. Запустите коллекцию целиком (Run collection): токены и id сохраняются автоматически, каждый шаг проверяется тестами.\n\nЛогин ограничен 10 попытками в минуту с IP — при частых повторных запусках возможен ответ 429.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://proweb.inzavic.uz",
      "type": "string",
      "description": "Адрес API"
    },
    {
      "key": "teacherUsername",
      "value": "teacher",
      "type": "string",
      "description": "Демо-учитель"
    },
    {
      "key": "studentUsername",
      "value": "student1",
      "type": "string",
      "description": "Демо-ученик"
    },
    {
      "key": "password",
      "value": "",
      "type": "string",
      "description": "Пароль демо-пользователей (задайте перед запуском)"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string",
      "description": "Заполняется автоматически"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string",
      "description": "Заполняется автоматически"
    },
    {
      "key": "previousRefreshToken",
      "value": "",
      "type": "string",
      "description": "Заполняется автоматически"
    },
    {
      "key": "basicCredentials",
      "value": "",
      "type": "string",
      "description": "Заполняется автоматически: base64(username:password)"
    },
    {
      "key": "studentId",
      "value": "",
      "type": "string",
      "description": "Заполняется автоматически"
    },
    {
      "key": "gradeId",
      "value": "",
      "type": "string",
      "description": "Заполняется автоматически"
    }
  ],
  "item": [
    {
      "name": "1. Учитель",
      "item": [
        {
          "name": "Login (teacher): Base64 вручную",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(() => {",
                  "  const raw = pm.collectionVariables.get('teacherUsername') + ':' + pm.variables.get('password');",
                  "  pm.collectionVariables.set('basicCredentials', CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(raw)));",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(() => {",
                  "  pm.test('status 200', () => pm.response.to.have.status(200));",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', data.access);",
                  "  pm.collectionVariables.set('refreshToken', data.refresh);",
                  "  pm.test('role is teacher', () => pm.expect(data.user.role).to.eql('teacher'));",
                  "  pm.test('JWT payload carries the role', () => {",
                  "    const payload = JSON.parse(atob(data.access.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "    pm.expect(payload.role).to.eql('teacher');",
                  "  });",
                  "})();"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Basic {{basicCredentials}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login",
                ""
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Pre-request скрипт кодирует `username:password` в Base64 (UTF-8) и кладёт в заголовок `Authorization: Basic …` — то же самое делает вкладка Authorization → Basic Auth."
          }
        },
        {
          "name": "Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(() => {",
                  "  pm.test('status 200', () => pm.response.to.have.status(200));",
                  "  pm.test('teacher profile', () => pm.expect(pm.response.json().role).to.eql('teacher'));",
                  "})();"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/me/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me",
                ""
              ]
            }
          }
        },
        {
